	Description: this program prompts for a city name and 
				 the current outdoor temperature in °F, 
				 then outputs a GREEN, YELLOW, or RED alert 
				 to indicate safe, cautionary, or dangerous 
				 conditions during the summer.
*/

package hw1_AlvarezRobert;
//import
import java.util.Scanner;

public class HW1_AlvarezRobert 
{
	public static void main(String[] args) 
	{
	//variables:
		//RAM variables
			int temp = 0 ;
			String city = " ";
			String alert = "";
		//working variable
			int repeat = 1;
			Scanner get = new Scanner(System.in);
			String input = " ";
			
		while (repeat == 1) { //program loop
			//input
				System.out.println("-----Temperature Alert System-----");
				System.out.println("---------- SUMMER TIME -----------");
				System.out.print("1. City name: ");
				city = get.nextLine();
				System.out.print("2. Outdoor temperature (°F): ");
				input = get.nextLine();
				input = input.trim();
				temp = Integer.parseInt(input);
			
			//process
				if (temp < 85) {
					alert = "GREEN";
				} else if (temp > 85 && temp < 95) { //exclusive
					alert = "YELLOW";
				} else {
					alert = "RED";
				}
					
			//output
				//record display
					System.out.println("------------- RESULT -------------");
					System.out.println("City: " + city);
					System.out.println("Temperature: " + temp + "°F");
					System.out.println("Alert code: " + alert);
				//ask to repeat
					System.out.println("------------- REPEAT -------------");
					System.out.println("Would you like to go again?");
					System.out.print("Enter 0 for No or 1 for Yes: ");
					input = get.nextLine();
					input = input.trim();
					repeat = Integer.parseInt(input);
				//using 'while loop' to validate 'repeat'
					while (repeat != 0 && repeat != 1) {
						System.out.println("------------ INVALID -------------");
						System.out.println("Please enter 0 for No or 1 for");
						System.out.print("Yes. Repeat the program? (0/1): ");
						input = get.nextLine();
						input = input.trim();
						repeat = Integer.parseInt(input);
					}
					System.out.println(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");
		} //end while
					System.out.println("------------ GOODBYE! ------------");
					System.out.println(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");
			
		get.close(); //closing scanner
	} //end main
} //end class HW1_AlvarezRobert
