class Membership implements Serializable
{
	//declaration:
			//objects
			String id;
			int    category;	//1 for life, 2 for regular
			String categoryText;
			double fees;
			String city;
			String state;
			String phone;
			String email;
			//working variable
			String input 	   = " ";
			DecimalFormat DF   = new DecimalFormat("###,##0.00");
			USstates stateList = new USstates();	//calling our USstates list class
			//FeeSchedule FS = new FeeSchedule		
	//constructors:
			Membership()
			{
					id 		 	 = " ";
					category 	 = 0  ;
					categoryText = " ";
					fees 	 	 = 0.0;
					city 	 	 = " ";
					state 	 	 = " ";
					phone 	 	 = " ";
					email 	 	 = " ";
			}//end constructor w/o arguments
			Membership(String id, int category, double fees, String city, String state, String phone, String email)
			{
					this.id 	  = id;
					this.category = category;
					this.fees 	  = fees;
					this.city 	  = city;
					this.state 	  = state;
					this.phone 	  = phone;
					this.email 	  = email;
			}//end constructor w/ arguments
	//Input Method ========================================================== 
			void getMemberData()
			{
					input = JOptionPane.showInputDialog("Enter 10-digit membership ID: ");
							while(!checkID(input))
							{
									input = JOptionPane.showInputDialog("Invalid! re-Enter 10-digit membership ID: ");
							}//end while
							id 			  = input;
					//---------------------------------------------------------------------------------------------------
					input = JOptionPane.showInputDialog("Enter category 1 for life or 2 for regular: ");
							while(!checkCategory(input))
							{
									input = JOptionPane.showInputDialog("Invalid! choose 1 for life or 2 for regular: ");
							}//end while
							category 	  = Integer.parseInt(input);	
							//-------------------------------------
							if(category == 1)
							{
									categoryText = "Life";
							} 
							else if(category == 2)
							{
									categoryText = "Regular";
							}
					//---------------------------------------------------------------------------------------------------
					input = JOptionPane.showInputDialog("Enter city: ");
							while(!checkSpaceLetter(input))
							{
									input = JOptionPane.showInputDialog("Invalid! re-Enter city: ");
							}//end while
							city 	 	  = input;
					//---------------------------------------------------------------------------------------------------
					input = JOptionPane.showInputDialog("Enter state: ");
							while(!checkSpaceLetter(input))
							{
									input = JOptionPane.showInputDialog("Invalid! re-Enter state: ");
							}//end while
						state 	 		  = stateList.getState(input);
					//---------------------------------------------------------------------------------------------------
					input = JOptionPane.showInputDialog("Enter phone number (digits only): ");
							while(!checkDigit(input))
							{
									input = JOptionPane.showInputDialog("Invalid! re-Enter phone number (digits only): ");
							}//end while
							phone	 	  = input;
					//---------------------------------------------------------------------------------------------------
					input = JOptionPane.showInputDialog("Enter email (e.i. xzy@company.com): ");
							while(!checkEmail(input))
							{
									input = JOptionPane.showInputDialog("Invalid! re-Enter email (e.i. xzy@company.com): ");
							}//end while
							email 	 	  = input;
			}//end getMemberData			
	//Fee Method ============================================================ 
			void setProFees(FeeSchedule FS) 	//calling FeeSchedule class FS
			{
					if(category == 1)			//life
					{
							fees = FS.proLife;
					}//end if category
					else if(category == 2)		//regular
					{
							fees = FS.proRegular;
					}//end else if
			}//end setFees
			//-------------------------------
			void setAmFees(FeeSchedule FS)
			{
					if(category == 1)			//life
					{
							fees = FS.amLife;
					}//end if category
					else if(category == 2)		//regular
					{
							fees = FS.amRegular;
					}//end else if
			}//end getAmFees
	//Display Method ==========================================================
			void dispMember()
			{
					JOptionPane.showMessageDialog(null, "Membership Information:\n" 	   +
														"--------------------------------" + "\n" +
														"ID: 		   " + id   	  	   + "\n" +
														"Category: 	   " + categoryText    + "\n" + 
														"Fees: 		  $" + DF.format(fees) + "\n" +
														"City : 	   " + city 	  	   + "\n" +
														"State: 	   " + state 	  	   + "\n" +
														"Phone Number: " + phone		   + "\n" + 
														"Email: 	   " + email 	  	   + "\n");
			}//end dispMember
	//Validation Method ======================================================== 
			boolean checkID(String input)
			{
					if(input.isEmpty())
					{
							return false;
					}//end if
					//-------------------------------
					if(input.length() != 10) //confirm 10 characters
					{
							return false;
					}//end if length
					//-------------------------------
					for(int i = 0; i < 9; i++)	//are first 9 characters digits?
					{
							if(!Character.isDigit(input.charAt(i)))
							{
									return false;
							}//end if not digit
					}//end for i
					return true;
			}//end checkID
			//------------------------------------------------------------------------
			boolean checkCategory(String input)
			{
					if(input.isEmpty())
					{
							return false;
					}//end if
					//-------------------------------
					if(input.length() != 1)
					{
							return false;
					}//end if length
					//-------------------------------
					for(int i = 0; i < 1; i++)
					{
							if(!Character.isDigit(input.charAt(i)))
							{
									return false;
							}//end if not digit
					}//end for i
					//-------------------------------
					if(!input.equals("1") && !input.equals("2"))	//making strict rule
					{
							return false;
					}//end if
					return true;			
			}//end checkCategory
			//------------------------------------------------------------------------
			boolean checkSpaceLetter(String input)
			{
					if(input.isEmpty())
					{
							return false;
					}//end if
					//-------------------------------
					for(int i = 0; i < input.length(); i++)
					{
							if(!Character.isLetter(input.charAt(i)) && input.charAt(i) != ' ') //letters & space (' ') accepted
							{
									return false;
							}//end if
					}//end for i
					return true;
			}//end checkCity
			//------------------------------------------------------------------------
			boolean checkDigit(String input)
			{
					if(input.isEmpty())
					{
							return false;
					}//end if
					//-------------------------------
					if(input.length() != 10)
					{
							return false;
					}//end if length
					//-------------------------------
					for(int i = 0; i < input.length(); i++)
					{
							
							if(!Character.isDigit(input.charAt(i)))
							{
									return false;
							}//end if not letter
					}//end for i
					return true;
			}//end checkState
			//------------------------------------------------------------------------
			boolean checkEmail(String input) //creating email rules test
			{
					int atCount  = 0;  //atCount = @ count
					int dotCount = 0;
					//-------------------------------
					if(input.isEmpty())
					{
							return false;
					}//end if
					//-------------------------------					
					for(int i = 0; i < input.length(); i++)		//to only accept letters, '@', and '.' (i.e. email@mail.com)
					{
							if(!Character.isLetter(input.charAt(i)) && input.charAt(i) != '@' && input.charAt(i) != '.')
							{
								return false;
							}//end if no '@' and '.'
					}//end for i 
					//----------------------------------------------------
					for(int i = 0; i < input.length(); i++)		//count how many '@'
					{
							if(input.charAt(i) == '@')			//charAt for character at position (i)  
							{
									atCount++;	//adds 1
							}//end if atCount
					}//end for i
					//----------------------------------------------------
					for(int i = 0; i < input.length(); i++)		//count how many '.'
					{
							if(input.charAt(i) == '.')
							{
									dotCount++;
							}
					}//end for i
					//----------------------------------------------------
					if(atCount != 1)							//we only accept one '@' symbol
					{
							return false;
					}//end if atCount
					//----------------------------------------------------
					if(dotCount != 1)							//we only accept one '.' symbol
					{
							return false;
					}//end if atCount
					//----------------------------------------------------
					if(input.charAt(input.length() - 4) != '.')	//the fourth position (4) from the back (-) should be '.' (e.i. '.com')
					{
							return false;
					}
					return true;
			}//end checkEmail 
}//end class Membership
