						if(input.length() < 4)
						{
								return false;
						}//end i
						//-------------------------------
						for(int i = 0; i < input.length(); i++)
						{
								if(!Character.isLetter(input.charAt(i)) && input.charAt(i) != '.')
										return false;
						}//for i
						//-------------------------------
						for(int i = 0; i < input.length(); i++)
						{
								if(input.charAt(i) == '.')
										dotCount++;
						}//end for i
						//-------------------------------
						if(dotCount != 2)
						{
								return false;
						}//end if dotCount
						//-------------------------------
						if(input.charAt(input.length() - 4) != '.')
						{
								return false;
						}//end if
						return true;
				}//end checkCompanyWebsite
