 * Description: this program processes the payroll for 4 employees using
 *              a set of parallel arrays.
 */
public class PayrollV1 
{
	public static void main(String[] args) 
	{
		//declarations:  
			//object: employee
			String [] ssn   = {"111"     , "222"    , "333"    , "444"  };
			String [] First = {"Robert"  , "John"   , "Ali"    , "Sam"  };
			String [] Last  = {"Rich"    , "Maxwell", "Sanford", "Fredo"};
			double [] Rate  = { 12.34    ,  15.90   ,   34.25  , 10.75  };
			int    [] Hours = {   44     ,   35     ,   60     ,   20   };
			double [] Gross = {  0.0     ,   0.0    ,   0.0    ,   0.0  };
			//working variables:
		//process the gross:
		calcGross(Rate, Hours, Gross);
		//generate a payroll report
		report(ssn, First, Last, Rate, Hours, Gross);

	}//end main
	//============================================
	public static void calcGross(double [] Rate, int [] Hours, double [] Gross)
	{
		for(int i = 0; i < Rate.length; ++i)//any array will do
		{
			Gross[i] = Rate[i] * Hours[i];
		}//end for i
	}//end calcGross
	//=============================================
	public static void report(String [] ssn, String [] First, String [] Last,
			                  double [] Rate, int [] Hours, double [] Gross)
	{
		for(int i = 0; i < ssn.length; ++i)
		{
			System.out.println("Employee SSN: "           + ssn[i]   + "\n" + 
		                       "         First Name: "    + First[i] + "\n" +
					           "         Last Name: "     + Last[i]  + "\n" +
		                       "         Hourly Rate: $"  + Rate[i]  + "\n" +
					           "         Hours Worked: "  + Hours[i] + "\n" +
		                       "         Gross Salary: $" + Gross[i]);
		}//end for
	}//end report
	//==============================================
}//end class Payroll
