package arrayv2;

import java.util.Scanner;

public class Arrayv2 
{
	//declarations:
	static Scanner get = new Scanner(System.in);
	public static void main(String[] args) 
	{
		 //declarations:
		int [] num = {0,0,0,0,0}; //same as int [] num = {0}; and also: int []  num = new int[5];
		int i = 0;
		//populate the array with number 9:
		while(i < 5)
		{
			System.out.println("Enter an integer for position: " + i);
			num[i]  = get.nextInt();
			i++;
		}//end while(i < 5)
		//let's display the content of this array:
		i = 0;
		while(i < 5)
		{
			System.out.println("Value stored at position " + i + " is " + num[i]);
			i++;
		}//end while(i < 5)

	}//end main

}//end class Arrayv1
