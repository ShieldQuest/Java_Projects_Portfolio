 * Description: this program declares an array of size 5, populates it with number 9
 *              then displays the contents back
 */
package arrayv1;

public class Arrayv1 
{

	public static void main(String[] args) 
	{
		 //declarations:
		int [] num = {0,0,0,0,0}; //same as int [] num = {0}; and also: int []  num = new int[5];
		int i = 0;
		//populate the array with number 9:
		while(i < 5)
		{
			num[i]  = 9;
			i++;
		}//end while(i < 5)
		//let's display the content of this array:
		i = 0;
		while(i < 5)
		{
			System.out.println("Value storfed at position " + i + " is " + num[i]);
			i++;
		}//end while(i < 5)

	}//end main

}//end class Arrayv1
